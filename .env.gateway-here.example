# Separate Compose project so deploying the gateway cannot remove this host's
# existing remote worker stack.
COMPOSE_PROJECT_NAME=tme3bot-gateway

# Keep the backend container's internal port unchanged. Publish it on a free
# loopback port for the host reverse proxy; worker API already uses 8080.
BACKEND_PORT=8080
BACKEND_BIND_HOST=127.0.0.1
BACKEND_HOST_PORT=8081

# Use new gateway state paths. Do not reuse this host's remote worker profile root.
GATEWAY_DATA_ROOT=/srv/tme3bot/gateway
LOCAL_WORKER_DATA_ROOT=/srv/tme3bot/worker-local
UTILITY_WORKSPACE_HOST=/www/wwwroot/downloads
UTILITY_WORKSPACE_ROOT=/workspace

BACKEND_ENV_FILE=.env.backend
TELEGRAM_ENV_FILE=.env.telegram
LOCAL_WORKER_ENV_FILE=.env.worker.local
