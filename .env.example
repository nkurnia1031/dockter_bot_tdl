# Compose host settings. Runtime role settings live in:
#   .env.backend   <- copy from .env.backend.example
#   .env.telegram  <- copy from .env.telegram.example
#   .env.worker.local <- copy from .env.worker.local.example
COMPOSE_FILE=docker-compose.gateway.yml
BACKEND_ENV_FILE=.env.backend
TELEGRAM_ENV_FILE=.env.telegram
LOCAL_WORKER_ENV_FILE=.env.worker.local
WEB_ENV_FILE=.env.web

# For GitHub Actions releases, set these on each VPS to the GHCR package names,
# for example ghcr.io/owner/tme3bot-gateway and ghcr.io/owner/tme3bot-worker.
GATEWAY_IMAGE_NAME=tme3bot-gateway
WORKER_IMAGE_NAME=tme3bot-worker
WEB_IMAGE_NAME=tme3bot-web
IMAGE_TAG=latest
# Optional automatic registry login for `python run.py publish`.
# The token needs GHCR write:packages permission when pushing private images.
GHCR_USERNAME=
GHCR_TOKEN=
BACKEND_PORT=8080
WEB_PORT=3000
# Only needed when building locally. GitHub Actions passes its immutable base
# image reference when building gateway and worker images.
TME3BOT_BASE_IMAGE=tme3bot-base:py310-tdl0203
BASE_PLATFORM=linux/amd64
# `python3 run.py` runs a read-only preflight. `python3 run.py deploy` uses
# this target after checking the Git SHA image in the local daemon/registry.
DEPLOY_TARGET=gateway
# Optional fallback when Docker Compose v2 is not installed.
# COMPOSE_CMD=docker-compose

GATEWAY_DATA_ROOT=/www/wwwroot/downloads/HasilConvert/bot/akultan
LOCAL_WORKER_DATA_ROOT=/www/wwwroot/downloads/HasilConvert/bot/akultan
UTILITY_WORKSPACE_HOST=/www/wwwroot/downloads
UTILITY_WORKSPACE_ROOT=/workspace

# Optional Linux tdl binary copied into the worker image before build.
# TDL_HOST_BINARY=/usr/local/bin/tdl
